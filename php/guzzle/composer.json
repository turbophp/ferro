{
    "name": "ferro/guzzle",
    "description": "Ferro HTTP as a Guzzle handler — the HandlerStack seam, with curl's exception classes and Ferro's fate markers",
    "type": "library",
    "license": "Apache-2.0",
    "repositories": [
        { "type": "path", "url": "../client" },
        { "type": "path", "url": "../psr18" }
    ],
    "require": {
        "php": ">=8.2",
        "ferro/client": "@dev",
        "ferro/psr18": "@dev",
        "guzzlehttp/guzzle": "^7.9",
        "guzzlehttp/promises": "^2.0",
        "guzzlehttp/psr7": "^2.6"
    },
    "require-dev": {
        "phpstan/phpstan": "2.2.8",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Ferro\\Guzzle\\": "src/Guzzle/",
            "Ferro\\Http\\": "src/Http/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ferro\\Guzzle\\Tests\\": "tests/",
            "Ferro\\Tests\\": "../client/tests/"
        }
    },
    "scripts": { "test": "phpunit", "stan": "phpstan analyse src --level 9" },
    "config": { "sort-packages": true }
}
