{
    "name": "ferro/doctrine-dbal-driver",
    "description": "The DBAL 3 LANE of ferro/doctrine-dbal-driver: the same package, resolved against doctrine/dbal 3.x into its own vendor tree (vendor-dbal3/). Install with COMPOSER=composer.dbal3.json.",
    "type": "library",
    "license": "Apache-2.0",
    "repositories": [
        { "type": "path", "url": "../client" }
    ],
    "require": {
        "php": ">=8.2",
        "doctrine/dbal": "^3.8",
        "ferro/client": "@dev"
    },
    "require-dev": {
        "phpstan/phpstan": "2.2.8",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": { "psr-4": { "Ferro\\DBAL\\": "src/" } },
    "autoload-dev": {
        "psr-4": {
            "Ferro\\DBAL\\Tests\\": "tests/",
            "Ferro\\Tests\\": "../client/tests/"
        }
    },
    "config": { "sort-packages": true, "vendor-dir": "vendor-dbal3" }
}
